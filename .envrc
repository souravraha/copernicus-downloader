# Copernicus Data Space downloader credentials (eodag).
# Real secrets live in .envrc.local (gitignored) — never commit them here.
# .envrc.local should define (see .envrc.local.example):
#   EODAG__cop_dataspace__auth__credentials__username=<your CDSE account email>
#   EODAG__cop_dataspace__auth__credentials__password=<your CDSE account password>
if [ -f ".envrc.local" ]; then
  set -a
  . ./.envrc.local
  set +a
fi
